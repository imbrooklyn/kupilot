# Local-only planning and working documentation.
/docs/design/
/docs/_local/

# Local Go build outputs. The Makefile writes command binaries to /bin.
/bin/
/dist/

# Legacy root-level build outputs remain ignored.
/kupilot
/kupilot.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test, coverage, profiling, and debugger outputs.
*.test
*.coverprofile
/coverage/
/coverage.out
/coverage.html
/profiles/
__debug_bin*

# Local Go workspace files for this single-module project.
/go.work
/go.work.sum

# Local environment and secret-bearing configuration.
/.env
/.env.*
!/.env.example
/.envrc
/.direnv/
/config.local.yaml
/config.local.yml
/config.local.toml
/config.yaml
/config.yml

# Local KuPilot runtime data. Tests must use temporary directories instead.
/.kupilot/
/*.db
/*.db-shm
/*.db-wal
/*.sqlite
/*.sqlite-shm
/*.sqlite-wal
/*.sqlite3
/*.sqlite3-shm
/*.sqlite3-wal
/*.log
/.cache/
/tmp/

# Operating-system metadata.
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
